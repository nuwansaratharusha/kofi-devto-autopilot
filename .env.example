# ============================================================================
# Omnichannel Verified Content & Storefront Autopilot — Environment Config
# Copy this file to `.env` (`cp .env.example .env`) and fill in optional keys.
# Zero paid subscriptions or paid LLM keys are required.
# ============================================================================

# 1. Focused Month-1 Storefronts: Whop ($10 Min Payout · Built-in Marketplace) & Patreon ($25 Payoneer)
# Whop Business Dashboard: https://whop.com/dashboard/biz_Af4z3lgivbct7t/
# Generate Company API Key & Webhook Secret at https://whop.com/dashboard/biz_Af4z3lgivbct7t/developer/
WHOP_COMPANY_ID=biz_Af4z3lgivbct7t
WHOP_STORE_URL=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# Optional Legacy Nas.io Variables (Backward Compatibility Only)
NASIO_STORE_URL=
NASIO_WEBHOOK_SECRET=

# Create a Patreon Creator Access Token at https://www.patreon.com/portal/registration/register-clients
PATREON_URL=
PATREON_CREATOR_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CREATOR_REFRESH_TOKEN=

# 2. Dual Merchant-of-Record Storefronts (Direct Sri Lanka Bank Payouts)
# Gumroad ($0+ Instant Lead Magnet, $100 USD min Sri Lanka bank deposit)
GUMROAD_STORE_URL=
GUMROAD_ACCESS_TOKEN=

# Lemon Squeezy ($14 Flagship Kit, $50 USD min Sri Lanka bank wire)
LEMONSQUEEZY_STORE_URL=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=

# Optional Fallback Creator Profile & Storefront URLs (Defaults to Canonical Hub / Patreon / Lemon Squeezy / Gumroad)
KOFI_PROFILE_URL=
PRIMARY_STORE_URL=
MIRROR_STORE_URL=

# 3. Google Blogger API v3 Daily Series Publisher (30-Day Series)
# Run `python3 autopilot.py auth-blogger` after setting CLIENT_ID + CLIENT_SECRET
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_PUBLISH_MODE=draft

# 4. Official DEV.to (Forem v1) API (Mon / Wed / Fri Cadence)
# Leave empty to run in safe local dry-run mode (exports JSON payloads to exports/<slug>/).
DEVTO_API_KEY=
PUBLISH_MODE=draft

# Optional Legacy Pinterest API v5 Keys
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# 5. Canonical Static Blog & 30-Day Experiment Window (Asia/Colombo +05:30)
CANONICAL_BASE_URL=https://nuwansaratharusha.github.io/kofi-devto-autopilot
AUTHOR_NAME=Tharusha Nuwansara
TIMEZONE=Asia/Colombo
EXPERIMENT_START_DATE=2026-11-18
EXPERIMENT_END_DATE=2026-12-18
