# ============================================================================
# Ko-fi & DEV.to Verified Content Autopilot — Environment Configuration
# Copy this file to `.env` (`cp .env.example .env`) and fill in optional keys.
# Zero paid subscriptions or paid LLM keys are required.
# ============================================================================

# Official DEV.to (Forem v1) API key from https://dev.to/settings/extensions
# Leave empty to run in safe local dry-run mode (exports JSON payloads to exports/<slug>/).
DEVTO_API_KEY=

# Safe staging mode:
#   draft = uploads to DEV.to with "published": false for 60-second human review (recommended)
#   live  = publishes immediately on DEV.to
PUBLISH_MODE=draft

# Primary Storefront & Creator Profile URLs
KOFI_PROFILE_URL=https://ko-fi.com/tharushanuwansara
PRIMARY_STORE_URL=https://ko-fi.com/tharushanuwansara/shop

# Optional Mirror Storefront URL for regions needing Merchant-of-Record bank payouts
# (e.g., Polar.sh `https://polar.sh/<handle>` [$10 min] or Lemon Squeezy [$50 min] in Sri Lanka)
MIRROR_STORE_URL=

# Canonical Static Blog Base URL (GitHub Pages or custom domain; used for Medium Import & DEV.to SEO)
CANONICAL_BASE_URL=https://tharushanuwansara.github.io/kofi-devto-autopilot

# Author attribution & schedule timezone
AUTHOR_NAME=Tharusha Nuwansara
TIMEZONE=Asia/Colombo
